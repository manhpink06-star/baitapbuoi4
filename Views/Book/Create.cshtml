@model baitapbuoi4.Models.Book

@{
    ViewData["Title"] = "Thêm sách";
}

<h2>Thêm sách</h2>

<form asp-controller="Book"
      asp-action="Create"
      method="post">

    <div class="mb-3">

        <label asp-for="Name"
               class="form-label">
            Tên sách
        </label>

        <input asp-for="Name"
               class="form-control"
               style="width: 400px;" />

        <span asp-validation-for="Name"
              class="text-danger">
        </span>

    </div>


    <div class="mb-3">

        <label asp-for="Price"
               class="form-label">
            Giá
        </label>

        <input asp-for="Price"
               class="form-control"
               style="width: 400px;" />

        <span asp-validation-for="Price"
              class="text-danger">
        </span>

    </div>


    <button type="submit"
            class="btn btn-primary">

        Thêm sách

    </button>

    <a asp-action="Index"
       class="btn btn-secondary">

        Danh sách sách

    </a>

</form>


@if (ViewBag.Message != null)
{
    <br />

    <div class="alert alert-success"
         style="width: 400px;">

        @ViewBag.Message

    </div>
}


@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}