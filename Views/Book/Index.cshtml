@model List<baitapbuoi4.Models.Book>

@{
    ViewData["Title"] = "Danh sách sách";
}

<div class="container mt-4">

    <h2 class="mb-3">Book Management</h2>

    <a asp-controller="Book"
       asp-action="Create"
       class="btn btn-success mb-3">
        Thêm sách
    </a>

    <table class="table table-bordered table-striped">

        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Price</th>
                <th>Chức năng</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var book in Model)
            {
                <tr>

                    <td>@book.Id</td>

                    <td>@book.Name</td>

                    <td>@book.Price</td>

                    <td>
                        <a asp-controller="Book"
                           asp-action="Detail"
                           asp-route-id="@book.Id"
                           class="btn btn-primary btn-sm">

                            Chi tiết

                        </a>
                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>