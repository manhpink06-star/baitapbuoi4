<!DOCTYPE html>

<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Bài tập buổi 4
    </title>


    <script type="importmap"></script>


    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />


    <link rel="stylesheet"
          href="~/baitapbuoi4.styles.css"
          asp-append-version="true" />

</head>


<body>

    <!-- THANH MENU -->
    <header>

        <nav class="navbar navbar-expand-sm
            navbar-toggleable-sm
            navbar-light
            bg-white
            border-bottom
            box-shadow
            mb-3">

            <div class="container-fluid">


                <!-- TÊN WEBSITE -->

                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">

                    Bài tập buổi 4

                </a>


                <!-- NÚT MENU TRÊN MÀN HÌNH NHỎ -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon">
                    </span>

                </button>


                <!-- DANH SÁCH MENU -->

                <div class="navbar-collapse
                    collapse
                    d-sm-inline-flex
                    justify-content-between">

                    <ul class="navbar-nav flex-grow-1">


                        <!-- TRANG CHỦ -->

                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Index">

                                Trang chủ

                            </a>

                        </li>


                        <!-- BÀI 1 -->

                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-controller="Account"
                               asp-action="Login">

                                Bài 1 - Login

                            </a>

                        </li>


                        <!-- BÀI 2 -->

                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-controller="Book"
                               asp-action="Index">

                                Bài 2 - Quản lý sách

                            </a>

                        </li>


                        <!-- BÀI 3 -->

                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-controller="Book"
                               asp-action="Create">

                                Bài 3 - Validation

                            </a>

                        </li>


                        <!-- PRIVACY -->

                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Privacy">

                                Privacy

                            </a>

                        </li>


                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- NỘI DUNG TRANG -->

    <div class="container">

        <main role="main"
              class="pb-3">

            @RenderBody()

        </main>

    </div>


    <!-- FOOTER -->

    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; 2026 - baitapbuoi4

        </div>

    </footer>


    <!-- JAVASCRIPT -->

    <script src="~/lib/jquery/dist/jquery.min.js">
    </script>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>


    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>